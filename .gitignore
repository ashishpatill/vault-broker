node_modules/
*.log

# Never commit runtime state if someone points VAULTBROKER_HOME at the repo
.vaultbroker/
vault.json
state.json
audit.log
broker.sock
daemon.lock

# Credentials must never reach git, even in a test fixture.
*.pem
*.key
.env
.env.*
!/.env.example
# Archify scratch output. The published copy lives in docs/ and IS tracked; only the
# generator's working folder and its evidence sidecars are ignored.
.archify/
